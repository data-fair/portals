{
  "$id": "https://github.com/data-fair/portals/api/config",
  "x-exports": [
    "types",
    "validate"
  ],
  "x-ajv": {
    "coerceTypes": "array"
  },
  "type": "object",
  "title": "Api config",
  "additionalProperties": false,
  "required": [
    "privateDirectoryUrl",
    "mongoUrl",
    "port",
    "tmpDir",
    "observer",
    "secretKeys",
    "portalUrlPattern",
    "ingressControllers",
    "defaultLimits"
  ],
  "properties": {
    "mongoUrl": {
      "type": "string"
    },
    "port": {
      "type": "number"
    },
    "tmpDir": {
      "type": "string"
    },
    "privateDirectoryUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "privateEventsUrl": {
      "type": "string"
    },
    "privateDataFairUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "privateCaptureUrl": {
      "type": "string"
    },
    "secretKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identities",
        "sites"
      ],
      "properties": {
        "identities": {
          "type": "string"
        },
        "events": {
          "type": "string"
        },
        "sites": {
          "type": "string"
        },
        "ingress": {
          "type": "string"
        },
        "limits": {
          "type": "string"
        },
        "dataFair": {
          "type": "string",
          "description": "secret key of data-fair's publication-site writes (data-fair's secretKeys.portals), used for scope-restricted sessions"
        },
        "capture": {
          "type": "string",
          "description": "secret key of the capture service (its secretKeys.capture), used by the page preview"
        },
        "pseudoSession": {
          "type": "string",
          "description": "secret key of simple-directory's pseudo sessions (its secretKeys.pseudoSession), used by the page preview"
        }
      }
    },
    "defaultLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nbPages",
        "nbDomains",
        "pagePreviews"
      ],
      "properties": {
        "nbPages": {
          "type": "number"
        },
        "nbDomains": {
          "type": "number"
        },
        "pagePreviews": {
          "type": "object",
          "description": "renders of the preview of a page allowed per user in a window",
          "additionalProperties": false,
          "required": [
            "duration",
            "nb"
          ],
          "properties": {
            "duration": {
              "type": "number",
              "description": "window in seconds"
            },
            "nb": {
              "type": "number"
            }
          }
        }
      }
    },
    "observer": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "port": {
          "type": "number"
        }
      }
    },
    "portalUrlPattern": {
      "type": "string"
    },
    "privateIngressManagerUrl": {
      "type": "string"
    },
    "ingressControllers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upgradeRoot": {
      "type": "string"
    },
    "util": {},
    "get": {},
    "has": {}
  }
}
