// Dev environment of portals, see @data-fair/lib-dev. Agents: npx --no df-dev status | logs <pane> | restart <pane>
layout {
  pane split_direction="vertical" {
    pane name="shell" borderless=true
    pane name="status" command="./node_modules/.bin/df-status" {
      args "--start-deps"
    }
    pane name="ingress-manager" command="bash" {
      args "-c" "FORCE_COLOR=1 NODE_ENV=development exec ./node_modules/.bin/nodemon -e ts --watch dev --exec \"node --disable-warning=ExperimentalWarning\" dev/ingress-manager.ts"
    }
    pane name="bridge" command="./node_modules/.bin/df-agents-bridge" {
      start_suspended true
    }
  }
  pane split_direction="vertical" {
    pane name="ui" command="bash" {
      // under df-mem-cap's cgroup V8 sizes its heap to ~2.2 GB, and vite outgrows it on the page editor
      args "-c" "cd ui && FORCE_COLOR=1 NODE_CONFIG_DIR=../api/config/ exec ../node_modules/.bin/df-mem-cap vite --port $DEV_UI_PORT"
    }
    pane name="api" command="bash" {
      args "-c" "./node_modules/.bin/df-dev wait-deps && cd api && FORCE_COLOR=1 NODE_ENV=development DEBUG='upgrade*' exec ../node_modules/.bin/nodemon -e js,ts,json index.ts"
    }
    pane name="portal" command="bash" {
      // piped: in a real terminal nuxt switches to its interactive screen instead of plain logs
      args "-c" "./node_modules/.bin/df-dev wait-deps && cd portal && FORCE_COLOR=1 NUXT_MONGO_URL=mongodb://localhost:$MONGO_PORT/data-fair-portals-development NUXT_PORTAL_URL_PATTERN=http://{subdomain}.portals.$DEV_HOST:$NGINX_PORT NUXT_PRIVATE_DIRECTORY_URL=http://localhost:$SD_PORT NUXT_FRAME_ANCESTORS=http://$DEV_HOST:$NGINX_PORT ../node_modules/.bin/df-mem-cap nuxt dev 2>&1 | cat"
    }
  }
  pane name="urls" size=1 borderless=true command="bash" {
    args "-c" "echo -n -e \"Manager: \\e[1;96mhttp://$DEV_HOST:$NGINX_PORT/portals-manager/dev\\e[0m\"; exec sleep infinity"
  }
}
