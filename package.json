{
  "name": "@data-fair/portals",
  "version": "2.38.0",
  "description": "Portals manager for data-fair",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build-types": "mkdir -p ui/src/components/vjsf && df-build-types . --vjsf-dir ui/src/components/vjsf",
    "check-types": "tsc && npm -w portal run check-types && npm -w ui run check-types",
    "dev": "bash dev/run.sh",
    "dev-deps": "bash dev/deps.sh",
    "dev-setup": "bash dev/setup.sh",
    "dev-world": "node --disable-warning=ExperimentalWarning dev/world.ts",
    "dev:api": "cd api && FORCE_COLOR=1 NODE_ENV=development DEBUG='upgrade*' exec ../node_modules/.bin/nodemon -e js,mjs,ts,json,md index.ts",
    "dev:ui": "cd ui && FORCE_COLOR=1 NODE_CONFIG_DIR=../api/config/ exec ../node_modules/.bin/vite --port ${DEV_UI_PORT}",
    "dev:portal": "cd portal && FORCE_COLOR=1 NUXT_MONGO_URL=\"${NUXT_MONGO_URL:-mongodb://localhost:$MONGO_PORT/data-fair-portals-development}\" NUXT_PORTAL_URL_PATTERN=\"${NUXT_PORTAL_URL_PATTERN:-http://{subdomain\\}.portals.$DEV_HOST:$NGINX_PORT}\" NUXT_PRIVATE_DIRECTORY_URL=\"${NUXT_PRIVATE_DIRECTORY_URL:-http://localhost:$SD_PORT}\" NUXT_FRAME_ANCESTORS=\"${NUXT_FRAME_ANCESTORS:-http://$DEV_HOST:$NGINX_PORT}\" ../node_modules/.bin/nuxt dev 2>&1 | cat",
    "dev:ingress": "FORCE_COLOR=1 NODE_ENV=development exec ./node_modules/.bin/nodemon -e ts --watch dev --exec \"node --disable-warning=ExperimentalWarning\" dev/ingress-manager.ts",
    "dev:bridge": "./node_modules/.bin/df-agents-bridge",
    "stop-dev-deps": "docker compose --profile '*' stop",
    "dev-zellij": "df-dev zellij",
    "lint": "eslint . && npm -w portal run lint && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w portal run lint-fix && npm -w ui run lint-fix",
    "postinstall": "patch-package --error-on-fail",
    "prepare": "husky || true",
    "prepare-fonts": "rm -rf api/assets/fonts && mkdir api/assets/fonts && node dev/scripts/prepare-fonts.ts",
    "quality": "npm run lint && npm run build-types && npm -w ui run build && npm run check-types && npm run test && npm audit --omit=dev --audit-level=critical",
    "test": "EVENTS_LOG_LEVEL=alert playwright test",
    "test-unit": "npm run test -- --project=unit",
    "test-api": "npm run test -- --project=api",
    "test-api-fast": "npm run test -- --project=api --max-failures=1",
    "test-e2e": "npm run test -- --project=e2e",
    "simulate": "playwright test -c playwright.sim.config.ts --project=simulate",
    "simulate:report": "dotenv -- node --experimental-strip-types --disable-warning=ExperimentalWarning simulations/report.ts",
    "simulate:compare": "node --experimental-strip-types --disable-warning=ExperimentalWarning simulations/compare.ts"
  },
  "workspaces": [
    "api",
    "ui",
    "portal",
    "shared/markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/data-fair/portals.git"
  },
  "author": "Alban Mouton <alban.mouton@koumoul.com>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://gitlab.com/data-fair/portals/issues"
  },
  "homepage": "https://gitlab.com/data-fair/portals#readme",
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@data-fair/lib-types-builder": "^1.14.5",
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@data-fair/lib-agents-sim": "^0.15.1",
    "@data-fair/lib-common-types": "^1.28.1",
    "@data-fair/lib-dev": "^0.1.0",
    "@data-fair/lib-node": "^3.0.0",
    "@data-fair/lib-utils": "^1.14.0",
    "@data-fair/openapi-mcp": "^0.14.0",
    "@json-layout/agents": "^0.5.1",
    "@koumoul/vjsf-compiler": "~1.6.0",
    "@koumoul/vjsf-markdown": "^0.5.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/test": "^1.59.1",
    "@types/config": "^3.3.5",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.3",
    "@types/memoizee": "^0.4.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.14",
    "@types/resolve-path": "^1.4.3",
    "@types/sanitize-html": "^2.16.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.4.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "form-data": "^4.0.4",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "jose": "^6.2.15",
    "neostandard": "^0.14.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "tough-cookie": "^5.1.2",
    "typescript": "^6.0.3",
    "undici": "^7.14.0"
  },
  "overrides": {
    "@nuxt/devtools": "4.0.0-beta.4",
    "mermaid": {
      "katex": "0.18.10"
    },
    "xss": "1.0.15",
    "@json-layout/agents": {
      "@json-layout/core": "~2.14.0"
    }
  },
  "relativeDependencies": {
    "@data-fair/lib-vue": "../lib/packages/vue",
    "@data-fair/lib-vuetify": "../lib/packages/vuetify"
  }
}
