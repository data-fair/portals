# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 5650-5699 so that they rarely collide with other local services.
DEV_HOST=localhost
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5650
DEV_API_PORT=5651
DEV_UI_PORT=5652
DEV_UI_HMR_PORT=5653
DEV_PORTAL_PORT=5654
DEV_OBSERVER_PORT=5655
DEV_INGRESS_PORT=5656
BRIDGE_PORT=5657
MAILDEV_UI_PORT=5658
MAILDEV_SMTP_PORT=5659
MONGO_PORT=5660
ES_PORT=5661
SD_PORT=5662
DF_PORT=5663
EVENTS_PORT=5664
AGENTS_PORT=5665
MCP_PORT=5666
CAPTURE_PORT=5667
